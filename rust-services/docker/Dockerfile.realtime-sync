# Multi-stage build for Realtime Sync
FROM rust:1.83-slim-bookworm AS builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY common ./common
COPY realtime-sync ./realtime-sync

# Build release
RUN cargo build --release --package realtime-sync

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/realtime-sync /usr/local/bin/

EXPOSE 8082

CMD ["realtime-sync"]
