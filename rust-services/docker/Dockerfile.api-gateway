# Multi-stage build for API Gateway
FROM rust:1.85-slim-bookworm AS builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY common ./common
COPY api-gateway ./api-gateway
COPY shape-validator ./shape-validator
COPY realtime-sync ./realtime-sync
COPY render-service ./render-service

# Create stub for benchmarks and integration-tests (not needed for build)
RUN mkdir -p benchmarks/src integration-tests/src && \
    echo 'fn main() {}' > benchmarks/src/main.rs && \
    echo 'fn main() {}' > integration-tests/src/main.rs && \
    echo '[package]\nname = "benchmarks"\nversion = "0.1.0"\nedition = "2021"\n[dependencies]' > benchmarks/Cargo.toml && \
    echo '[package]\nname = "integration-tests"\nversion = "0.1.0"\nedition = "2021"\n[dependencies]' > integration-tests/Cargo.toml

# Build release
RUN cargo build --release --package api-gateway

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/api-gateway /usr/local/bin/

EXPOSE 8080

CMD ["api-gateway"]
